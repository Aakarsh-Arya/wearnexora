  </section>

  <!-- Quote form -->
  <section id="quote" class="mx-auto max-w-3xl px-3 sm:px-6 mt-12">
    <div class="bg-white rounded-2xl ring-1 ring-slate-200 shadow-sm p-6 sm:p-8">
      <h2 class="text-2xl font-bold">Get a quick quote</h2>
      <p class="text-slate-600 text-sm mt-1">We'll call you back in 10–15 mins.</p>
      
      <!-- Selected products display -->
      <div id="selectedProductsContainer">
        <label class="block text-sm font-medium mt-4 mb-2">Selected Products</label>
        <div id="selectedProductsList" class="selected-products" style="display: none;">
          <!-- Products will be inserted here -->
        </div>
      </div>

  <form id="quoteForm" class="mt-5 space-y-4" name="quote" netlify data-netlify="true" data-netlify-honeypot="company" aria-describedby="quoteStatus">
        <input type="hidden" name="form-name" value="quote" />
        <input type="hidden" name="selectedProducts" id="selectedProductsInput" />
        <input type="hidden" name="products" id="products" />
        
        <div>
          <label for="quoteName" class="block text-sm font-medium">Name *</label>
          <input id="quoteName" required name="name" type="text" autocomplete="name" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 outline-none focus:ring-2 focus:ring-sky-500" />
        </div>
        <div>
          <label for="quotePhone" class="block text-sm font-medium">Phone *</label>
          <input id="quotePhone" required name="phone" type="tel" inputmode="numeric" autocomplete="tel" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 outline-none focus:ring-2 focus:ring-sky-500" />
        </div>
        <div>
          <label class="block text-sm font-medium">Product type (optional)</label>
          <div id="productChips" class="mt-1 flex flex-wrap gap-2"></div>
          <input type="hidden" name="productType" id="productType" />
        </div>
        <div>
          <label class="block text-sm font-medium">Upload your designs (optional)</label>
          <div class="mt-1 relative">
            <input type="file" name="designs" id="designUpload" multiple accept="image/*,.pdf,.ai,.psd" 
                   class="hidden" onchange="handleFileUpload(this)" />
            <label for="designUpload" 
                   class="flex items-center justify-center w-full h-32 border-2 border-dashed border-slate-300 rounded-lg cursor-pointer hover:border-slate-400 transition-colors">
              <div class="text-center">
                <div class="text-2xl mb-2">📎</div>
                <div class="text-sm text-slate-600">
                  <span class="font-medium text-sky-600">Click to upload</span> or drag and drop
                </div>
                <div class="text-xs text-slate-500 mt-1">
                  PNG, JPG, PDF, AI, PSD up to 10MB each
                </div>
              </div>
            </label>
            <div id="fileList" class="mt-2 space-y-1"></div>
          </div>
        </div>
        <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" />
        <button type="submit" class="rounded-xl bg-slate-900 text-white px-5 py-3 font-semibold">Get Quote</button>
  <a href="https://wa.me/918360833126?text=Hi%20AURA%20team" target="_blank" rel="noopener noreferrer" class="ml-3 text-sky-700 hover:underline text-sm">Prefer WhatsApp?</a>
        <p class="text-[11px] text-slate-500 mt-2">By submitting, you agree to be contacted by AURA.</p>
      </form>
  <div id="quoteStatus" class="mt-4 text-sm" aria-live="polite"></div>
    </div>
  </section>

  <!-- Use-case grid -->
  <section id="usecases" class="mx-auto max-w-7xl px-3 sm:px-6 mt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-bold">Perfect for…</h2>
      <p class="text-slate-600 text-sm">Made for every moment that matters</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-5 shadow-sm hover:shadow transition" data-usecase="fests">
        <div class="text-3xl">🎉</div>
        <h3 class="mt-2 font-semibold">College Fests</h3>
        <p class="text-sm text-slate-600">Bulk merch that makes your fest unforgettable.</p>
        <button class="mt-3 text-sky-700 hover:underline text-sm get-quote-uc">Get a Quote →</button>
      </div>
      <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-5 shadow-sm hover:shadow transition" data-usecase="section_merch">
        <div class="text-3xl">🎓</div>
        <h3 class="mt-2 font-semibold">Section Merch</h3>
        <p class="text-sm text-slate-600">Build unity, wear your batch pride.</p>
        <button class="mt-3 text-sky-700 hover:underline text-sm get-quote-uc">Get a Quote →</button>
      </div>
      <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-5 shadow-sm hover:shadow transition" data-usecase="sports_teams">
        <div class="text-3xl">🏆</div>
        <h3 class="mt-2 font-semibold">Sports Teams</h3>
        <p class="text-sm text-slate-600">One jersey, one spirit—on & off the field.</p>
        <button class="mt-3 text-sky-700 hover:underline text-sm get-quote-uc">Get a Quote →</button>
      </div>
      <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-5 shadow-sm hover:shadow transition" data-usecase="club_identity">
        <div class="text-3xl">🔗</div>
        <h3 class="mt-2 font-semibold">Club Identity</h3>
        <p class="text-sm text-slate-600">Your vibe, your brand, your aura.</p>
        <button class="mt-3 text-sky-700 hover:underline text-sm get-quote-uc">Get a Quote →</button>
      </div>
      <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-5 shadow-sm hover:shadow transition" data-usecase="events_giveaways">
        <div class="text-3xl">🎁</div>
        <h3 class="mt-2 font-semibold">Events & Giveaways</h3>
        <p class="text-sm text-slate-600">Gifts that carry your brand everywhere.</p>
        <button class="mt-3 text-sky-700 hover:underline text-sm get-quote-uc">Get a Quote →</button>
      </div>
      <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-5 shadow-sm hover:shadow transition" data-usecase="corporate_alumni">
        <div class="text-3xl">🧑‍💼</div>
        <h3 class="mt-2 font-semibold">Corporate & Alumni</h3>
        <p class="text-sm text-slate-600">Professional yet personal—for teams & memories.</p>
        <button class="mt-3 text-sky-700 hover:underline text-sm get-quote-uc">Get a Quote →</button>
      </div>
    </div>
  </section>

  <!-- Coming soon carousel -->
  <section class="mx-auto max-w-7xl px-3 sm:px-6 mt-12">
    <div class="mb-3">
      <h2 class="text-2xl font-bold">✨ Coming Soon</h2>
      <p class="text-slate-600 text-sm">New drops you’ll love</p>
    </div>
    <div class="relative rounded-2xl overflow-hidden bg-slate-200">
      <div id="comingTrack" class="carousel-track flex">
        <div class="min-w-full"><img src="https://images.unsplash.com/photo-1557800636-894a64c1696f?q=80&w=1600&auto=format&fit=crop" alt="Yearbook" class="w-full h-72 sm:h-96 object-cover" /></div>
        <div class="min-w-full"><img src="https://images.unsplash.com/photo-1498804103079-a6351b050096?q=80&w=1600&auto=format&fit=crop" alt="Mugs" class="w-full h-72 sm:h-96 object-cover" /></div>
        <div class="min-w-full"><img src="https://images.unsplash.com/photo-1579047134765-3a03f94b1876?q=80&w=1600&auto=format&fit=crop" alt="Keychains" class="w-full h-72 sm:h-96 object-cover" /></div>
      </div>
      <div class="absolute inset-0 bg-black/5 flex items-center justify-center">
        <div class="text-center text-white">
          <div class="text-sm tracking-widest">COMING SOON</div>
        </div>
      </div>
      <div class="absolute inset-x-0 bottom-2 flex items-center justify-center gap-2">
        <span class="dot bg-white/80" data-cdot="0"></span>
        <span class="dot bg-white/40" data-cdot="1"></span>
        <span class="dot bg-white/40" data-cdot="2"></span>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="mx-auto max-w-4xl px-3 sm:px-6 mt-12 mb-16">
    <h2 class="text-2xl font-bold">Frequently Asked Questions</h2>
    <div class="mt-4 divide-y divide-slate-200" id="faqList">
      <!-- Example items; add up to 10–12 -->
      <div class="py-3">
        <button id="faq-q-shipping_policy" class="w-full flex items-center justify-between text-left faq-q" aria-expanded="false" aria-controls="faq-a-shipping_policy" data-id="shipping_policy">
          <span class="font-medium">What’s the typical delivery time?</span>
          <span class="transition-transform rotate-0">▸</span>
        </button>
        <div id="faq-a-shipping_policy" class="mt-2 text-sm text-slate-600 hidden" role="region" aria-labelledby="faq-q-shipping_policy">Usually 7–10 working days, depending on quantity and customization.</div>
      </div>
      <div class="py-3">
        <button id="faq-q-min_order" class="w-full flex items-center justify-between text-left faq-q" aria-expanded="false" aria-controls="faq-a-min_order" data-id="min_order">
          <span class="font-medium">Is there a minimum order quantity?</span>
          <span class="transition-transform rotate-0">▸</span>
        </button>
        <div id="faq-a-min_order" class="mt-2 text-sm text-slate-600 hidden" role="region" aria-labelledby="faq-q-min_order">We’re bulk-friendly; MOQs vary by product. Share your needs in the quote form.</div>
      </div>
      <div class="py-3">
        <button id="faq-q-quality_prints" class="w-full flex items-center justify-between text-left faq-q" aria-expanded="false" aria-controls="faq-a-quality_prints" data-id="quality_prints">
          <span class="font-medium">What print methods do you support?</span>
          <span class="transition-transform rotate-0">▸</span>
        </button>
        <div id="faq-a-quality_prints" class="mt-2 text-sm text-slate-600 hidden" role="region" aria-labelledby="faq-q-quality_prints">DTF, screen print, embroidery, and more—picked to match your design and budget.</div>
      </div>
    </div>
    <div class="mt-4 text-sm">
      Didn't find your answer? <a href="#quote" class="text-sky-700 hover:underline" onclick="event.preventDefault(); document.getElementById('quote').scrollIntoView({behavior:'smooth'});">Drop your question</a> and we'll get back.
    </div>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"What’s the typical delivery time?","acceptedAnswer":{"@type":"Answer","text":"Usually 7–10 working days, depending on quantity and customization."}},
        {"@type":"Question","name":"Is there a minimum order quantity?","acceptedAnswer":{"@type":"Answer","text":"We’re bulk-friendly; MOQs vary by product. Share your needs in the quote form."}},
        {"@type":"Question","name":"What print methods do you support?","acceptedAnswer":{"@type":"Answer","text":"DTF, screen print, embroidery, and more—picked to match your design and budget."}}
      ]
    }
    </script>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-300">
    <div class="mx-auto max-w-7xl px-3 sm:px-6 py-6 text-xs flex items-center justify-between">
      <p>© <span id="year"></span> AURA</p>
      <p>No tracking cookies. Fast quotes.</p>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="scripts.js" defer></script>

  <!-- Image modal/lightbox (mobile) -->
  <div id="imgModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-75 flex items-center justify-center" aria-hidden="true">
    <div class="relative w-full h-full max-w-4xl max-h-full">
      <button id="imgModalClose" class="absolute top-4 right-4 z-10 text-white text-2xl">&times;</button>
      <div id="imgModalTrack" class="w-full h-full overflow-hidden">
        <div data-track class="flex h-full transition-transform duration-500">
          <!-- slides inserted here by JS -->
        </div>
      </div>
      <div id="imgModalDots" class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2">
        <!-- dots inserted here by JS -->
      </div>
    </div>
    <div data-close class="absolute inset-0 -z-10"></div>
  </div>

  <!-- Simple Quote Reminder -->
  <div id="quoteReminder" class="fixed bottom-4 right-4 bg-slate-900 text-white px-4 py-2 rounded-lg shadow-lg text-sm font-medium z-20 opacity-0 transition-opacity duration-300" style="display: none;">
    📋 Check your quote below!
  </div>

</body>
</html>

