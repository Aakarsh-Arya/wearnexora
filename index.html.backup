  <!-- Reviews -->
  <section id="reviews" class="border-t border-stone-200 bg-[var(--paper)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <h2 class="text-2xl sm:text-3xl font-bold">Loved by student crews</h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <figure class="rounded-2xl bg-white p-6 ring-1 ring-stone-200 card-hover">
