      linear-gradient(180deg, #fff 0%, var(--cream) 100%)}
    .shimmer{background-size:200% 100%;animation:shimmer 10s ease-in-out infinite}
    @keyframes shimmer{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
    .btn-pop{transition:transform .2s ease, box-shadow .2s ease}
    .btn-pop:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(2,6,23,.08)}
    .card-hover{transition:transform .3s ease, box-shadow .3s ease}
    .card-hover:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(2,6,23,.10)}
    .no-scrollbar::-webkit-scrollbar{display:none}
    .no-scrollbar{scrollbar-width:none;-ms-overflow-style:none}
    [data-row]{touch-action: pan-x pan-y; cursor: grab;} /* allow vertical scroll */
    [data-row].dragging{cursor: grabbing; scroll-behavior: auto !important;}
    @supports (overscroll-behavior-x: contain){
      [data-row]{ overscroll-behavior-x: contain; } /* avoid page rubber-band on horizontal fling */
    }
    .carousel-track{transition: transform 600ms ease;}
    .rotator{opacity:1;transition:opacity .5s ease}
    .rotator.hide{opacity:0}
    @media (prefers-reduced-motion: reduce){.btn-pop,.card-hover,.shimmer{animation:none!important;transition:none!important}}

    /* --- HERO container (duplicate kept in sync) --- */
    .hero-box{
      position: relative;
      overflow: hidden;
      min-height: clamp(420px, 52dvh, 680px);
    }
    @media (min-width: 768px){
      .hero-box{ aspect-ratio: 16 / 9; min-height: 520px; }
    }

    .hero-overlay{
      position: absolute; inset: 0; z-index: 10;
      display: grid; grid-template-columns: 1fr;
      align-items: center; pointer-events: none;
    }
    .hero-overlay > :last-child{ display: none; }
    @media (min-width: 768px){
      .hero-overlay{ grid-template-columns: 48% 1fr; }
      .hero-overlay > :last-child{ display: block; }
    }

    #heroPanel{
      --hero-pad: clamp(12px, 4vw, 20px);
      height: 100%; padding: var(--hero-pad);
      display: flex; align-items: center; justify-content: flex-start;
      pointer-events: auto; background: transparent;
    }

    #heroCopy{
      max-width: min(560px, 92vw);
      transform: none !important;
    }
    #heroCopy h1{
      white-space: normal;
      font-weight: 800; line-height: 1.1; margin-top: 8px;
      font-size: clamp(22px, 6vw, 56px);
    }
    #subTagline{ font-size: clamp(14px, 2.6vw, 18px); margin-top: .7rem; }
    #heroCopy .cta-row{ margin-top: clamp(10px, 2.2vw, 20px); gap: clamp(8px, 2vw, 16px); }

    .hero-box img{ object-position: 74% center; }
    @media (min-width: 1024px){ .hero-box img{ object-position: center; } }

    @media (max-width: 640px){
      #prevBtn, #nextBtn{ top: auto; bottom: 10px; transform: none; }
      #prevBtn{ left: 10px; }  #nextBtn{ right: 10px; }
    }

    /* add/override at the end of your existing styles */

    /* Give the hero a definite height */
    .hero-box{
      height: clamp(420px, 52dvh, 680px);   /* was only min-height */
    }
    @media (min-width: 768px){
      .hero-box{ aspect-ratio: 16/9; }      /* keeps pleasant desktop height */
    }

    /* Make track/slides fill the hero height */
    .hero-box .carousel-track{ height: 100%; }
    .hero-box .carousel-track > .slide{ height: 100%; }

    /* Ensure image truly fills and remove baseline gap */
    .hero-box .slide img{
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* HERO: lock ratio + scale copy with hero (not viewport) */
    .hero-box{
      aspect-ratio: 16 / 9;
      height: auto;
      min-height: 0;
      container-type: size; /* enable cqi/cqh */
    }

    /* Same crop everywhere */
    .hero-box .slide img{ object-position: center; display: block; }

    /* Caption scales with hero width */
    .hero-caption{ padding: clamp(10px, 2cqi, 24px); }
    .hero-caption-inner{
      font-size: clamp(12px, 1.2cqi, 16px); /* base for ems below */
      max-width: min(560px, 92cqi);
    }
    .hero-caption-inner h1{ font-size: 3em; line-height: 1.1; margin-top: .4em; }
    .hero-caption-inner .caption-sub{ font-size: 1.1em; margin-top: .7em; }

    /* Buttons and gaps scale too */
    .hero-caption-inner .cta-row{
      display: flex; flex-wrap: wrap;
      gap: clamp(8px, 1.6cqi, 16px);
      margin-top: clamp(8px, 2cqi, 20px);
    }
    .hero-caption-inner .cta-row a{
      font-size: 1em;
      padding: clamp(9px, 1.1cqi, 14px) clamp(14px, 1.6cqi, 22px);
      border-radius: clamp(8px, 1.2cqi, 12px);
    }

    /* Ensure slides fill hero exactly */
    .hero-box .carousel-track{ height: 100%; }
    .hero-box .carousel-track > .slide{ height: 100%; }
    .hero-box .slide img{ width: 100%; height: 100%; object-fit: cover; }

    /* FINAL HERO OVERRIDES — keep image and text in fixed proportion */
    .hero-box{
      aspect-ratio: 16 / 9;
      height: auto !important;
      min-height: 0 !important;
      container-type: size;              /* enables cqi/cqh */
    }

    .hero-box .carousel-track{ height: 100%; }
    .hero-box .carousel-track > .slide{ height: 100%; }
    .hero-box .slide img{
      display: block; width: 100%; height: 100%;
      object-fit: cover;                 /* no distortion */
      object-position: center;           /* same framing */
    }

    /* Caption scales with hero (not viewport) */
    .hero-caption{ padding: 3cqi !important; } /* proportional inset */
    .hero-caption-inner{
      /* Strict proportional base; clamp keeps it readable on very small/large screens */
      font-size: clamp(12px, 1.35cqi, 16px);
      max-width: 42cqi;                  /* copy block width stays proportional */
    }
    .hero-caption-inner h1{
      font-size: 3.3em;                  /* scales from base above */
      line-height: 1.1;
      margin-top: .5em;
    }
    .hero-caption-inner .caption-sub{ font-size: 1.15em; margin-top: .8em; }

    /* Buttons and gaps scale too */
    .hero-caption-inner .cta-row{
      display: flex; flex-wrap: wrap;
      gap: 1.6cqi;                       /* proportional gap */
      margin-top: 2.2cqi;
    }
    .hero-caption-inner .cta-row a{
      font-size: 1em;
      padding: 1.1cqi 1.8cqi;            /* overrides Tailwind px- utilities here */
      border-radius: 1.1cqi;
    }

    /* Optional: move arrows on tiny phones (kept) */
    @media (max-width: 640px){
      #prevBtn, #nextBtn{ top: auto; bottom: 10px; transform: none; }
      #prevBtn{ left: 10px; }  #nextBtn{ right: 10px; }
    }

    /* HERO — strict proportional scaling of copy to image */
    .hero-box{
      aspect-ratio: 16 / 9;
      height: auto !important;
      min-height: 0 !important;
      container-type: size; /* enables cqi/cqh */
    }

    /* Fill hero exactly */
    .hero-box .carousel-track{ height: 100%; }
    .hero-box .carousel-track > .slide{ height: 100%; }
    .hero-box .slide img{
      display: block; width: 100%; height: 100%;
      object-fit: cover;
      object-position: center !important; /* same crop on all screens */
    }

    /* Copy scales with hero width (not viewport) */
    .hero-caption{ padding: 3cqi !important; }
    .hero-caption-inner{
      max-width: 42cqi;
      font-size: 1.35cqi !important; /* exact proportional base (remove clamp) */
    }

    /* All sizes derived from the proportional base */
    .hero-caption-inner h1{
      font-size: 3.3em !important;
      line-height: 1.1;
      margin-top: .5em !important;
    }
    .hero-caption-inner .caption-sub{
      font-size: 1.15em !important;
      margin-top: .8em !important;
    }

    /* Buttons and gaps scale too (override Tailwind px- classes) */
    .hero-caption-inner .cta-row{
      display: flex; flex-wrap: wrap;
      gap: 1.6cqi !important;
      margin-top: 2.2cqi !important;
    }
    .hero-caption-inner .cta-row a{
      font-size: 1em !important;
      padding: 1.1cqi 1.8cqi !important;
      border-radius: 1.1cqi !important;
    }

    /* HERO chip — scale with hero (proportional to caption base) */
    .hero-caption-inner > span.inline-flex:first-child{
      font-size: .85em !important;   /* inherits from .hero-caption-inner (cqi-based) */
      line-height: 1 !important;
      padding: .55em .9em !important;
      gap: .5em !important;
      border-radius: 9999px !important; /* keep pill look, proportional */
    }

    /* HERO headline subline — 20% smaller than H1, bold, proportional */
    .hero-caption-inner h1 .sub-kicker{
      display: block;
      font-size: .8em !important;   /* 20% smaller than h1 */
      font-weight: 800 !important;
      margin-top: .18em !important; /* slight gap under the main line */
    }

    /* Force H1 to exactly two lines: 
       1) "What you customize" 
       2) "becomes your aura" */
    .hero-caption-inner h1 .line1,
    .hero-caption-inner h1 .line2{
      display: block;
      white-space: nowrap !important; /* keep each phrase on its own line */
    }

    /* Make the two headline lines 95% of H1 size (all slides) */
    .hero-caption-inner h1 .line1,
    .hero-caption-inner h1 .line2{
      font-size: .95em !important;
    }

    /* HERO: mobile = touch scroll + snap, hide arrows; desktop keeps arrows */
    @media (max-width: 767px){
      #prevBtn, #nextBtn{ display: none !important; }

      #carouselTrack{
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      #carouselTrack::-webkit-scrollbar{ display: none; }
      #carouselTrack > .slide{ scroll-snap-align: start; }
      /* no transform animation on mobile track */
      .hero-box .carousel-track{ transition: none !important; }
    }

    /* Dots visible on all views */
    .dot{
      width: 10px; height: 10px;
      border-radius: 9999px;
      display: inline-block;
    }

    /* Mobile: hide T‑Shirts/Hoodies/Varsity row arrows; touch scroll only */
    @media (max-width: 767px){
      .row-prev, .row-next{ display: none !important; }
    }

    /* Ronaldo head-pop: leave ~40% empty at top */
    .head-pop{ background: var(--cream); }
    .head-pop > img{
      /* override Tailwind absolute inset-0 + sizing */
      top: auto !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      height: 60% !important;   /* leaves ~40% empty at top */
      width: 100% !important;
      object-fit: contain !important;
      object-position: bottom center !important;
    }

    /* Smooth anchor scroll + offset for sticky header */
    html{ scroll-behavior: smooth; }
    section[id]{ scroll-margin-top: 80px; }

    /* T‑Shirt #4 hover rotator */
    .rotator-card{ position: relative; }
    .rotator-card .frame{
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: contain;
      opacity: 0; transition: opacity .25s ease;
    }
    .rotator-card .frame.active{ opacity: 1; }
    .rotator-dots{
      position: absolute; top: 8px; right: 8px;
      display: none; gap: 6px;
    }
    .rotator-card.rot-show .rotator-dots{ display: flex; }
    .rotator-dots .dot{
      width: 8px; height: 8px; border-radius: 9999px;
      background: rgba(0,0,0,.28);
    }
    .rotator-dots .dot.active{ background: #fff; }

    /* Hide rotator dots entirely */
    .rotator-dots{ display: none !important; }

    /* Ensure first frame shows by default (mobile/no-hover) */
    .rotator-card .frame:first-of-type{ opacity: 1 !important; }

    /* Modal open/close animation */
    #imgModal{
      opacity: 0; pointer-events: none;
      transition: opacity 200ms ease;
    }
    #imgModal.open{
      opacity: 1; pointer-events: auto;
    }
    #imgModal .modal-shell{
      transform: scale(0.96);
      transition: transform 220ms ease;
    }
    #imgModal.open .modal-shell{
      transform: scale(1);
    }

    /* Default first frame visible when no hover */
    .rotator-card .frame{ position:absolute; inset:0; width:100%; height:100%; object-fit:contain; opacity:0; transition:opacity .25s; }
    .rotator-card .frame:first-of-type{ opacity:1 !important; }

    /* Optional dots (inside modal) */
    #imgModalDots .dot{ width:8px; height:8px; border-radius:9999px; background:#ffffff66; }
    #imgModalDots .dot.active{ background:#fff; }

    /* Fix product card text overlapping */
    .shrink-0 .relative .absolute.inset-x-0.bottom-0 {
      /* Increase padding and ensure proper spacing */
      padding: 16px 12px 12px 12px !important;
      min-height: 80px; /* Ensure enough vertical space */
    }

    /* CLEAN FIX: Move ALL discount badges to top-right corner */
    span.absolute.top-2.left-2 {
      top: 6px !important;
      left: auto !important;
      right: 6px !important;
      z-index: 30 !important;
    }

    /* Alternative selector to catch all discount badges */
    .absolute.top-2.left-2,
    .absolute[class*="top-2"][class*="left-2"] {
      top: 6px !important;
      left: auto !important;
      right: 6px !important;
      z-index: 30 !important;
    }

    /* Clean up text area spacing */
    .shrink-0 .relative .absolute.inset-x-0.bottom-0 {
      padding: 16px 12px 12px 12px !important;
      min-height: 80px !important;
    }

    /* Enhanced gradient for better text readability */
    .shrink-0 .relative .bg-gradient-to-t {
      background: linear-gradient(to top, 
        rgba(255,255,255,0.98) 0%, 
        rgba(255,255,255,0.92) 50%, 
        rgba(255,255,255,0.75) 70%,
        rgba(255,255,255,0.3) 85%,
        transparent 100%) !important;
    }
  </style>
</head>
