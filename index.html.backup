      display: block; width: 100%; height: 100%;
      object-fit: cover;
      object-position: center !important; /* same crop on all screens */
    }

    /* Copy scales with hero width (not viewport) */
    .hero-caption{ padding: 3cqi !important; }
    .hero-caption-inner{
      max-width: 42cqi;
      font-size: 1.35cqi !important; /* exact proportional base (remove clamp) */
    }

    /* All sizes derived from the proportional base */
    .hero-caption-inner h1{
      font-size: 3.3em !important;
      line-height: 1.1;
      margin-top: .5em !important;
    }
    .hero-caption-inner .caption-sub{
      font-size: 1.15em !important;
      margin-top: .8em !important;
    }

    /* Buttons and gaps scale too (override Tailwind px- classes) */
    .hero-caption-inner .cta-row{
      display: flex; flex-wrap: wrap;
      gap: 1.6cqi !important;
      margin-top: 2.2cqi !important;
    }
    .hero-caption-inner .cta-row a{
      font-size: 1em !important;
      padding: 1.1cqi 1.8cqi !important;
      border-radius: 1.1cqi !important;
    }

    /* HERO chip — scale with hero (proportional to caption base) */
    .hero-caption-inner > span.inline-flex:first-child{
      font-size: .85em !important;   /* inherits from .hero-caption-inner (cqi-based) */
      line-height: 1 !important;
      padding: .55em .9em !important;
      gap: .5em !important;
      border-radius: 9999px !important; /* keep pill look, proportional */
    }

    /* HERO headline subline — 20% smaller than H1, bold, proportional */
    .hero-caption-inner h1 .sub-kicker{
      display: block;
      font-size: .8em !important;   /* 20% smaller than h1 */
      font-weight: 800 !important;
      margin-top: .18em !important; /* slight gap under the main line */
    }

    /* Force H1 to exactly two lines: 
       1) "What you customize" 
       2) "becomes your aura" */
    .hero-caption-inner h1 .line1,
    .hero-caption-inner h1 .line2{
      display: block;
      white-space: nowrap !important; /* keep each phrase on its own line */
    }

    /* Make the two headline lines 95% of H1 size (all slides) */
    .hero-caption-inner h1 .line1,
    .hero-caption-inner h1 .line2{
      font-size: .95em !important;
    }

    /* HERO: mobile = touch scroll + snap, hide arrows; desktop keeps arrows */
    @media (max-width: 767px){
      #prevBtn, #nextBtn{ display: none !important; }

      #carouselTrack{
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      #carouselTrack::-webkit-scrollbar{ display: none; }
      #carouselTrack > .slide{ scroll-snap-align: start; }
      /* no transform animation on mobile track */
      .hero-box .carousel-track{ transition: none !important; }
    }

